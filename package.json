{
  "name": "optical-bench",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "description": "2D optical table layout designer (mm-accurate)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen": "node scripts/gen-library.mjs",
    "icon": "node scripts/make-icon.mjs",
    "app:mac": "node scripts/make-mac-app.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "node scripts/ui-test.mjs && node scripts/ui-test-v11.mjs && node scripts/optics-test.mjs",
    "app:build": "bash scripts/build-mac-app.sh",
    "app:run": "open \"build/Optical Bench.app\"",
    "test:optics": "node scripts/optics-test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
