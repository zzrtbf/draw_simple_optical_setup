# 换行符统一：仓库内存 LF，检出时按平台还原
* text=auto

# Windows 批处理必须是 CRLF；macOS 启动脚本必须是 LF（CRLF 会让 shebang 失效）
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.command text eol=lf
*.sh      text eol=lf

# 二进制：不参与 diff / 换行转换
*.png   binary
*.ico   binary
*.icns  binary
*.dmg   binary
*.zip   binary
*.exe   binary
